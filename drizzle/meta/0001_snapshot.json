      "checkConstraints": {
        "attempts_state_check": {
          "name": "attempts_state_check",
          "value": "\"attempts\".\"state\" IN ('pending', 'dispatching', 'session_created', 'running', 'completed')"
        },
        "attempts_outcome_check": {
          "name": "attempts_outcome_check",
          "value": "\"attempts\".\"outcome\" IS NULL OR \"attempts\".\"outcome\" IN ('succeeded', 'failed', 'cancelled', 'escalated')"
        },
        "attempts_completed_outcome_check": {
          "name": "attempts_completed_outcome_check",
          "value": "(\"attempts\".\"state\" = 'completed') = (\"attempts\".\"outcome\" IS NOT NULL)"
        },
        "attempts_session_id_check": {
          "name": "attempts_session_id_check",
          "value": "\"attempts\".\"state\" NOT IN ('session_created', 'running') OR \"attempts\".\"devin_session_id\" IS NOT NULL"
        }
