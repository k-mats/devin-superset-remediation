      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "attempts_attempt_number_check": {
          "name": "attempts_attempt_number_check",
          "value": "\"attempts\".\"attempt_number\" > 0"
        },
        "attempts_state_check": {
          "name": "attempts_state_check",
          "value": "\"attempts\".\"state\" IN ('pending', 'dispatching', 'session_created', 'running', 'verifying', 'completed')"
        },
        "attempts_outcome_check": {
          "name": "attempts_outcome_check",
          "value": "\"attempts\".\"outcome\" IS NULL OR \"attempts\".\"outcome\" IN ('succeeded', 'failed', 'cancelled', 'escalated', 'no_action')"
        },
        "attempts_completed_outcome_check": {
          "name": "attempts_completed_outcome_check",
          "value": "(\"attempts\".\"state\" = 'completed') = (\"attempts\".\"outcome\" IS NOT NULL)"
        },
        "attempts_session_id_check": {
          "name": "attempts_session_id_check",
          "value": "\"attempts\".\"state\" NOT IN ('session_created', 'running', 'verifying') OR \"attempts\".\"devin_session_id\" IS NOT NULL"
        },
        "attempts_agent_outcome_check": {
          "name": "attempts_agent_outcome_check",
          "value": "\"attempts\".\"agent_outcome\" IS NULL OR \"attempts\".\"agent_outcome\" IN ('remediated', 'needs_human', 'no_action')"
        },
        "attempts_succeeded_session_check": {
          "name": "attempts_succeeded_session_check",
          "value": "\"attempts\".\"outcome\" IS NULL OR \"attempts\".\"outcome\" <> 'succeeded' OR \"attempts\".\"devin_session_id\" IS NOT NULL"
        },
        "attempts_pr_fields_check": {
          "name": "attempts_pr_fields_check",
          "value": "\"attempts\".\"pr_number\" IS NULL OR \"attempts\".\"pr_url\" IS NOT NULL"
        },
        "attempts_pr_state_check": {
          "name": "attempts_pr_state_check",
          "value": "\"attempts\".\"pr_state\" IS NULL OR \"attempts\".\"pr_state\" IN ('open', 'closed', 'merged')"
        },
        "attempts_verification_candidate_source_check": {
          "name": "attempts_verification_candidate_source_check",
          "value": "\"attempts\".\"verification_candidate_source\" IS NULL OR \"attempts\".\"verification_candidate_source\" IN ('issue_verification_section', 'agent_tests_run', 'operator')"
        },
        "attempts_verification_candidate_check": {
          "name": "attempts_verification_candidate_check",
          "value": "(\"attempts\".\"verification_candidate_sha256\" IS NULL) = (\"attempts\".\"verification_candidate_shell\" IS NULL) AND (\"attempts\".\"verification_candidate_sha256\" IS NULL) = (\"attempts\".\"verification_candidate_script\" IS NULL) AND (\"attempts\".\"verification_candidate_sha256\" IS NULL) = (\"attempts\".\"verification_candidate_source\" IS NULL) AND (\"attempts\".\"verification_candidate_sha256\" IS NULL) = (\"attempts\".\"verification_candidate_updated_at\" IS NULL)"
        },
        "attempts_verification_approved_check": {
          "name": "attempts_verification_approved_check",
          "value": "(\"attempts\".\"verification_approved_sha256\" IS NULL) = (\"attempts\".\"verification_approved_shell\" IS NULL) AND (\"attempts\".\"verification_approved_sha256\" IS NULL) = (\"attempts\".\"verification_approved_script\" IS NULL) AND (\"attempts\".\"verification_approved_sha256\" IS NULL) = (\"attempts\".\"verification_approved_at\" IS NULL) AND (\"attempts\".\"verification_approved_sha256\" IS NULL) = (\"attempts\".\"verification_approved_by\" IS NULL)"
        }
      }
