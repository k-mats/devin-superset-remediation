# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/orchestrator.db
# Optional path for pnpm demo:restart (defaults to ./data/demo-state-restart.db)
# DEMO_DATABASE_PATH=./data/demo-state-restart.db

# GitHub intake configuration
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_INTAKE_LABEL=devin-ready
# Set to 0 to disable periodic intake polling
GITHUB_POLL_INTERVAL_MS=60000

# Devin API Configuration (v3 Organization API)
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_URL=https://api.devin.ai/v3
# Set to 0 to disable periodic dispatch polling
DEVIN_DISPATCH_INTERVAL_MS=60000
# Set to 0 to disable periodic session and pull request tracking
DEVIN_TRACKING_INTERVAL_MS=60000
# Warn when a Devin session has not updated for this many milliseconds; 0 disables warnings
DEVIN_SESSION_STALE_WARN_MS=21600000
# Maximum ACUs a dispatched Devin session may consume
DEVIN_MAX_ACU_PER_SESSION=5

# Logging
LOG_LEVEL=info

# Independent verification (Issue #13)
# Set to 0/false to disable independent command verification of remediations
VERIFICATION_ENABLED=true
# Per-repository workspace directory used for clean checkouts of pull request heads
VERIFICATION_WORKSPACE_ROOT=./data/verification
# Timeout for a single verification command run
VERIFICATION_COMMAND_TIMEOUT_MS=900000
# Timeout for repository setup (e.g. uv pip install)
VERIFICATION_SETUP_TIMEOUT_MS=1800000
# Timeout for git clone/fetch/checkout of the pull request head
VERIFICATION_CHECKOUT_TIMEOUT_MS=300000
# Maximum bytes of command output retained in verification evidence
VERIFICATION_MAX_OUTPUT_BYTES=16384