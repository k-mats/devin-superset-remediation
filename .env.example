# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
# Empty disables cross-origin browser requests.
CORS_ALLOWED_ORIGINS=

# Database Configuration
DATABASE_PATH=./data/orchestrator.db

# GitHub Configuration (for future use)
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Devin API Configuration (for future use)
DEVIN_API_KEY=
DEVIN_API_URL=

# Logging
LOG_LEVEL=info